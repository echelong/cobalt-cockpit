        "commander": { "provider": "cline-pass", "model": "cline-pass/kimi-k3.1-pro", "reasoning": "high" },
        "coder": { "provider": "cline-pass", "model": "cline-pass/deepseek-v4.1-flash-1017", "reasoning": "xhigh", "requireName": "1017" },
        "specialist": { "provider": "cline-pass", "model": "cline-pass/mimo-v2.6-pro", "reasoning": "high" },
        "frontend": { "provider": "cline-pass", "model": "cline-pass/qwen3.8-max", "reasoning": "xhigh", "requireName": "0902" },
        "utility": { "provider": "cline-pass", "model": "cline-pass/glm-5.3-flash", "reasoning": "low" }
      }
    }
  },
  "escalation": { "coder": "commander", "specialist": "commander", "frontend": "commander", "utility": "coder", "commander": null },
  "pricingOverrides": {},
  "budgets": {
    "sessionUsd": 3.0,
    "sessionTokens": 40000000,
    "taskUsd": { "commander": 1.5, "coder": 0.75, "specialist": 0.75, "frontend": 1.0, "utility": 0.2 },
    "taskTokens": { "commander": 3000000, "coder": 4000000, "specialist": 3000000, "frontend": 3000000, "utility": 1000000 },
    "alertAt": [0.5, 0.8, 1.0],
    "allowUnmetered": false,
    "onSessionCap": "cancel"
