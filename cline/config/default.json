  "estimates": {
    "commander": { "input": 300000, "output": 30000, "cacheRatio": 0.5 },
    "coder": { "input": 400000, "output": 20000, "cacheRatio": 0.6 },
    "specialist": { "input": 300000, "output": 20000, "cacheRatio": 0.5 },
    "frontend": { "input": 300000, "output": 20000, "cacheRatio": 0.5 },
    "utility": { "input": 100000, "output": 5000, "cacheRatio": 0.5 }
  },
  "limits": {
    "maxTasksPerMission": null,
    "maxQueue": 64,
    "maxDelegationDepth": 2,
    "maxChildrenPerTask": 3,
    "concurrency": { "total": 6, "commander": 1, "coder": 6, "specialist": 2, "frontend": 2, "utility": 4 },
    "perProvider": { "cline": 6, "cline-pass": 6 },
    "spawnsPerMinute": 12,
    "minFreeMemoryMB": 700,
    "maxLoadPerCpu": 2.0,
    "maxAttemptsPerTask": 4,
    "maxCorrectionsPerTask": 1,
    "retryBaseMs": 2000,
